@using SignalRWebUI.Dtos.BasketDtos;
@model List<ResultBasketDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    int count = 0;
    decimal totalPrice = 0;
}

<style>
    .basketCuponForm {
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
        border-width: 4px;
        border-color: #ffc107;
    }

        .basketCuponForm:focus {
            border-color: #ffc107;
        }

    .basketCuponButton {
        border-top-left-radius: 0;
        border-bottom-left-radius: 0;
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
        border-width: 4px;
        border-color: #ffc107;
        background-color: #ffc107;
        display: flex;
        justify-content: center;
        align-items: center;
    }
</style>
<br />
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-dark mb-30">
                <a class="breadcrumb-item text-light" href="/Home/Index">Anasayfa</a>
                <a class="breadcrumb-item text-light" href="/Menu/Index">Menu</a>
                <span class="breadcrumb-item active">Sepetiniz</span>
            </nav>
        </div>
    </div>
</div>
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            <table class="table table-light table-borderless table-hover text-center mb-0">
                <thead class="thead-dark">
                    <tr>
                        <th>#</th>
                        <th>Ürün Adı</th>
                        <th>Adet</th>
                        <th>Fiyat</th>
                        <th>Sil</th>
                    </tr>
                </thead>
                @foreach (var item in Model)
                {
                    count++;
                    totalPrice += (item.Price * item.Quantity);
                    <tbody class="align-middle">
                        <tr>
                            <td class="align-middle">@count</td>
                            <td class="align-middle">@item.ProductName</td>
                            <td class="align-middle">@item.Quantity</td>
                            <td class="align-middle">@item.Price</td>
                            <td class="align-middle btn btn-delete"><a href="/Basket/Delete/@item.Id" class="btn btn-sm btn-danger"><i class="fa fa-times"></i></a></td>
                        </tr>
                    </tbody>
                }

            </table>
        </div>
        <div class="col-log-4 mb-5">
            <form>
                <div class="input-group h-100">
                    <input type="text" id="cuponcode" style="box-shadow:none" class="form-control p-4 basketCuponForm" placeholder="Kupon Kodunuz" />
                    <div>
                        <a class="btn btn-warning h-100 basketCuponButton" id="btncuponcode"><span class="text-white">Kuponu Uygula</span></a>
                    </div>
                </div>
            </form>
            <br />
            <h5 class="section-title text-uppercase mb-3 d-flex justify-content-center"><span class="bg-warning p-2 px-5" style="border-radius:45px">Sepet Özeti</span></h5>
            <div class="p-3" style="background-color: #e7e6e1; border-radius: 20px">
                <div id="container" class="border-bottom pb-2">
                    <div class="d-flex justify-content-between">
                        <h6>Toplam Tutar</h6>
                        <h6><span id="totalprice">@(totalPrice - totalPrice / 5)</span>₺</h6>
                    </div>

                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">KDV Oranı</h6>
                        <h6><span id="kdv">@(totalPrice / 5)</span>₺</h6>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between">
                        <h5 class="font-weight-medium">Toplam</h5>
                        <h5><span id="kdv">@totalPrice</span>₺</h5>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
